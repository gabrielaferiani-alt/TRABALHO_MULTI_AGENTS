# Quantum Finance — Variáveis de Ambiente
# Copie este arquivo para .env e preencha com suas chaves

# OBRIGATÓRIO: Chave da API do Google (Gemini)
# Obtenha em: https://aistudio.google.com/apikey
GOOGLE_API_KEY=sua_chave_google_api_aqui

# OPCIONAL: Chave SerpAPI para pesquisa web em tempo real
# Sem esta chave, o sistema usa a base de conhecimento embutida
# Obtenha em: https://serpapi.com (plano gratuito: 100 buscas/mês)
SERPAPI_KEY=sua_chave_serpapi_aqui

# OPCIONAL: Chave Bolsai MCP para dados B3 via MCP
# Plano gratuito: 200 requisições/dia
# Obtenha em: https://bolsai.com.br
BOLSAI_API_KEY=sua_chave_bolsai_aqui
